# The build context is backend/ (docker-compose.yml: context: .). COPY . . in
# the Dockerfile's builder stage would otherwise sweep every one of these
# into the image (and, via BuildKit's cache-to: type=gha, into the GitHub
# Actions cache) — most critically the real .env with production secrets,
# and a host-installed node_modules that would silently overwrite the
# builder's own platform-correct `npm ci` output for native deps (sharp,
# bcrypt).

# Secrets — never bake these into an image or a build cache layer.
.env
.env.*
!.env.example

# Dependencies — the builder stage runs its own `npm ci`; a host copy here
# would overwrite it with wrong-platform native binaries.
node_modules/

# Build output — regenerated by `npm run build` inside the image.
dist/

# Runtime data — these are volumes/external storage in production, not
# something that belongs in the image.
uploads/
logs/

# Git metadata — irrelevant to the running app, needlessly bloats context.
.git/
.gitignore

# Tests, editor, OS cruft — not needed at runtime.
src/__tests__/
coverage/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
