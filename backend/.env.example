# ─── Database ─────────────────────────────────────────────────────────────────
# Production should use connection_limit=15-20 to handle concurrent request load.
DATABASE_URL="postgresql://postgres:password@localhost:5432/affinity?schema=public&connection_limit=15"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-chars
JWT_EXPIRES_IN=7d

# ─── Magic Link ───────────────────────────────────────────────────────────────
MAGIC_LINK_EXPIRES_MINUTES=15
APP_URL=http://localhost:3000

# ─── Email — SMTP over port 587 ───────────────────────────────────────────────
# Brevo:  SMTP_HOST=smtp-relay.brevo.com, SMTP_USER=<login email>, SMTP_PASS=<SMTP key>
# Resend: SMTP_HOST=smtp.resend.com,       SMTP_USER=resend,        SMTP_PASS=<API key>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login@example.com
SMTP_PASS=your-smtp-api-key
EMAIL_FROM=noreply@affinity.example.com
EMAIL_FROM_NAME=Affinity Workspace

# ─── Blue-Green Deployment ────────────────────────────────────────────────────
# GitHub Container Registry owner (GitHub username or org that owns the package)
GHCR_OWNER=your-github-username-or-org
# Docker image tag to deploy (overridden per-deploy via deploy.sh argument)
IMAGE_TAG=latest
# PostgreSQL credentials — must match the db service in docker-compose.prod.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=affinity

# ─── Object Storage (AWS S3) ──────────────────────────────────────────────────
# REQUIRED in production — server refuses to start with placeholder values below.
# Local dev may keep placeholders; uploads fall back to backend/uploads/ on disk.
# Create a private S3 bucket + an IAM user scoped to it, then paste its keys.
# STORAGE_ENDPOINT is only for S3-compatible providers (e.g. OCI) — leave unset
# for native AWS S3. Legacy OCI_* variable names are still accepted.
STORAGE_REGION=ap-south-1
STORAGE_BUCKET_NAME=affinity-media
STORAGE_ACCESS_KEY_ID=your-aws-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-aws-secret-access-key
# STORAGE_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# How long media signed URLs stay valid (seconds). Default 3600 = 1 hour.
SIGNED_URL_EXPIRES_SECONDS=3600
