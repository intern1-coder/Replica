// Prisma schema — Affinity Workspace
// Phase 1: User, magic-link auth.
// Phase 2: Client, Property, PropertyTenantHistory, Job, JobStatus enum.
// Phase 3: WorkLog, JobMedia, CommunicationLog + new enums.
// Phase 4: AuditLog, GeneratedDocument.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  PM
  ADMIN
  ACCOUNTS
  OWNER
  CONTRACTOR
}

enum JobStatus {
  TO_BE_CHECKED
  CHECKED
  QUOTED
  AUTHORISED
  COMPLETED
  CANCELLED
}

enum MediaType {
  DIAGNOSTIC
  COMPLETION
}

enum CommunicationDirection {
  TO_TENANT
  TO_CLIENT
  INTERNAL
}

enum CommunicationMethod {
  CALL
  EMAIL
  WHATSAPP
  SYSTEM_NOTE
}

enum CommunicationOutcome {
  CONFIRMED
  NO_RESPONSE
  SENT
  LOGGED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum DocumentType {
  QUOTE
  JOB_SHEET
  COMPLETION_REPORT
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String
  role               Role
  hourlyRate         Decimal?  @db.Decimal(10, 2)

  passwordHash       String?
  tokenVersion       Int       @default(0)

  canAuthorizeJobs   Boolean   @default(false)

  // Sparse per-member permission overrides on top of the role preset.
  // Shape: { "jobs:edit": false, "audit:view": true }
  permissionOverrides Json?

  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  loggedWorkLogs           WorkLog[]          @relation("LoggedWorkLogs")
  uploadedMedia            JobMedia[]         @relation("UploadedMedia")
  performedCommunications  CommunicationLog[] @relation("PerformedCommunications")
  createdReminders         FollowUpReminder[] @relation("CreatedReminders")
  resolvedReminders        FollowUpReminder[] @relation("ResolvedReminders")

  auditLogsPerformed       AuditLog[]         @relation("AuditLogsPerformed")
  documentsGenerated       GeneratedDocument[] @relation("DocumentsGenerated")
  passwordResetTokens      PasswordResetToken[] @relation("UserResetTokens")

  @@map("users")
  @@index([email])
}

// ─────────────────────────────────────────────────────────────────────────────
// PasswordResetToken — single-use, expiring tokens for self-service reset.
// Only the SHA-256 hash of the token is stored; the raw token is emailed once.
// ─────────────────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation("UserResetTokens", fields: [userId], references: [id])

  @@map("password_reset_tokens")
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Client
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id        String    @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  jobs       Job[]
  properties Property[]
  tenants    Tenant[]

  @@map("clients")
  @@index([name])
}

// ─────────────────────────────────────────────────────────────────────────────
// Property
// ─────────────────────────────────────────────────────────────────────────────

model Property {
  id                 String    @id @default(uuid())
  address            String
  normalizedAddress  String
  buildingGroupId    String?

  parentId           String?
  parent             Property? @relation("PropertySubUnits", fields: [parentId], references: [id])
  subUnits           Property[] @relation("PropertySubUnits")

  currentClientId    String?
  currentClient      Client?   @relation(fields: [currentClientId], references: [id])

  accessNotes        String?
  keyLocation        String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  jobs          Job[]
  tenantHistory PropertyTenantHistory[]
  tenants       Tenant[] @relation("PropertyTenants")
  lastTenants   Tenant[] @relation("PropertyLastTenants")

  @@map("properties")
  @@index([normalizedAddress])
  @@index([currentClientId])
  @@index([parentId])
  @@index([buildingGroupId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenant
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String    @id @default(uuid())
  name      String
  email     String?
  phone     String?
  notes     String?

  propertyId String?
  property   Property? @relation("PropertyTenants", fields: [propertyId], references: [id])

  lastPropertyId String?
  lastProperty   Property? @relation("PropertyLastTenants", fields: [lastPropertyId], references: [id])
  
  lastClientId   String?
  lastClient     Client?   @relation(fields: [lastClientId], references: [id])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  jobs Job[]

  @@map("tenants")
  @@index([name])
}

// ─────────────────────────────────────────────────────────────────────────────
// PropertyTenantHistory
// ─────────────────────────────────────────────────────────────────────────────

model PropertyTenantHistory {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  tenantName  String
  tenantPhone String?
  movedIn     DateTime
  movedOut    DateTime?
  notes       String?

  createdAt DateTime @default(now())

  @@map("property_tenant_history")
  @@index([propertyId, movedIn])
}

// ─────────────────────────────────────────────────────────────────────────────
// Job
// ─────────────────────────────────────────────────────────────────────────────

model Job {
  id       String @id @default(uuid())
  sequence Int    @unique @default(autoincrement())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  tenantSnapshotName  String?
  tenantSnapshotPhone String?

  status  JobStatus @default(TO_BE_CHECKED)
  version Int       @default(0)

  description     String?
  diagnosticNotes String?
  completionNotes String?
  materials       String?
  quotedValue     Decimal? @db.Decimal(10, 2)

  assignedContractors Engineer[] @relation("JobContractors")

  scheduledDate DateTime?
  completedAt   DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  workLogs          WorkLog[]
  quoteLineItems    JobQuoteLineItem[]
  media             JobMedia[]
  communicationLogs CommunicationLog[]
  followUpReminders FollowUpReminder[]
  auditLogs         AuditLog[]
  generatedDocuments GeneratedDocument[]

  @@map("jobs")
  @@index([status, createdAt])
  @@index([propertyId, createdAt])
  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────────────────────
// WorkLog
// ─────────────────────────────────────────────────────────────────────────────

model WorkLog {
  id           String   @id @default(uuid())

  jobId        String
  job          Job      @relation(fields: [jobId], references: [id])

  contractorId String
  contractor   Engineer @relation("ContractorWorkLogs", fields: [contractorId], references: [id])

  loggedById   String
  loggedBy     User     @relation("LoggedWorkLogs", fields: [loggedById], references: [id])

  hoursWorked  Decimal  @db.Decimal(6, 2)
  rateApplied  Decimal  @db.Decimal(10, 2)
  materialCost Decimal  @default(0) @db.Decimal(10, 2)

  workDate     DateTime @db.Date
  notes        String?

  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("work_logs")
  @@index([jobId])
  @@index([contractorId])
  @@index([workDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// JobMedia
// ─────────────────────────────────────────────────────────────────────────────

model JobMedia {
  id           String    @id @default(uuid())

  jobId        String
  job          Job       @relation(fields: [jobId], references: [id])

  storageKey   String
  mediaType    MediaType
  fileName     String
  mimeType     String
  sizeBytes    Int

  uploadedById String
  uploadedBy   User      @relation("UploadedMedia", fields: [uploadedById], references: [id])

  createdAt    DateTime  @default(now())

  @@map("job_media")
  @@index([jobId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CommunicationLog
// ─────────────────────────────────────────────────────────────────────────────

model CommunicationLog {
  id            String                 @id @default(uuid())

  jobId         String
  job           Job                    @relation(fields: [jobId], references: [id])

  performedById String
  performedBy   User                   @relation("PerformedCommunications", fields: [performedById], references: [id])

  direction     CommunicationDirection
  method        CommunicationMethod
  outcome       CommunicationOutcome
  notes         String?

  loggedAt      DateTime               @default(now())
  createdAt     DateTime               @default(now())

  @@map("communication_logs")
  @@index([jobId])
  @@index([performedById])
}

// ─────────────────────────────────────────────────────────────────────────────
// FollowUpReminder
// ─────────────────────────────────────────────────────────────────────────────

enum ReminderStatus {
  OPEN
  DONE
  DISMISSED
}

model FollowUpReminder {
  id                       String         @id @default(uuid())

  jobId                    String
  job                      Job            @relation(fields: [jobId], references: [id])

  createdById              String
  createdBy                User           @relation("CreatedReminders", fields: [createdById], references: [id])

  resolvedById             String?
  resolvedBy               User?          @relation("ResolvedReminders", fields: [resolvedById], references: [id])

  sourceCommunicationLogId String?        // comm log that spawned this reminder (context only)

  dueAt                    DateTime
  note                     String?
  status                   ReminderStatus @default(OPEN)
  resolvedAt               DateTime?
  resolvedReason           String?        // "Follow-up logged" | "Marked done" | "Dismissed"
  notifiedAt               DateTime?      // last time browser push fired — set by client via PATCH

  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@map("follow_up_reminders")
  @@index([jobId])
  @@index([status, dueAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AuditLog
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id            String      @id @default(uuid())

  entityType    String      // 'Job', 'Property', 'Client', 'WorkLog'
  entityId      String      // ID of the affected entity
  action        AuditAction

  performedById String
  performedBy   User        @relation("AuditLogsPerformed", fields: [performedById], references: [id])

  before        Json?       // Snapshot of entity before change
  after         Json?       // Snapshot of entity after change

  jobId         String?     // Optional association for job-level timeline
  job           Job?        @relation(fields: [jobId], references: [id])

  createdAt     DateTime    @default(now())

  @@map("audit_logs")
  @@index([entityType, entityId])
  @@index([jobId])
  @@index([performedById])
}

// ─────────────────────────────────────────────────────────────────────────────
// GeneratedDocument
// ─────────────────────────────────────────────────────────────────────────────

model GeneratedDocument {
  id             String       @id @default(uuid())

  jobId          String
  job            Job          @relation(fields: [jobId], references: [id])

  type           DocumentType
  storageKey     String       // OCI Object Storage key

  snapshotData   Json         // The raw data used to render this PDF

  generatedById  String
  generatedBy    User         @relation("DocumentsGenerated", fields: [generatedById], references: [id])

  createdAt      DateTime     @default(now())

  @@map("generated_documents")
  @@index([jobId])
}

// ─────────────────────────────────────────────────────────────────────────────
// JobQuoteLineItem
// ─────────────────────────────────────────────────────────────────────────────

model JobQuoteLineItem {
  id          String   @id @default(uuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])
  description String
  price       Decimal  @db.Decimal(10, 2)
  status      String?  @default("COMPLETED")

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("job_quote_line_items")
  @@index([jobId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Engineer
// ─────────────────────────────────────────────────────────────────────────────

model Engineer {
  id         String    @id @default(uuid())
  name       String
  phone      String?
  email      String?
  hourlyRate Decimal?  @db.Decimal(10, 2)

  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  assignedJobs Job[]     @relation("JobContractors")
  workLogs     WorkLog[] @relation("ContractorWorkLogs")

  @@map("engineers")
  @@index([name])
}

// ─────────────────────────────────────────────────────────────────────────────
// Setting
// ─────────────────────────────────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}
